{% minify %}

{% do _globals.set('css', {
	navLink: 'uppercase group inline-flex items-center text-center font-medium tracking-widest lg:leading-6 hover:text-gray-900 focus:text-gray-900 transition ease-in-out duration-150 focus:outline-none',
	navLinkOnLight: 'block uppercase text-base font-medium tracking-widest leading-6',
	breakoutLink: "!static content-[''] before:block before:absolute before:inset-0 before:cursor-pointer"
}) %}

{# fetch any scripts marked as essential from the Scripts section #}
{% set essentialCat = craft.entries.type('cookieTypes').slug('essential').one() %}
{% set scriptsToLoadUpfront = essentialCat ? craft.entries.section('scripts')
	.with(['cookieType'])
	.cookieType(essentialCat)
	.all()
%}

{# filter essential scripts  into 3 different groups for head/body-start/body-end #}
{% set scriptsToLoadUpfrontAtHead = essentialCat ? scriptsToLoadUpfront|filter(script => script.scriptOutputLocation == 'head') %}
{% set scriptsToLoadUpfrontAtBodyStart = essentialCat ? scriptsToLoadUpfront|filter(script => script.scriptOutputLocation == 'bodyStart') %}
{% set scriptsToLoadUpfrontAtBodyEnd = essentialCat ? scriptsToLoadUpfront|filter(script => script.scriptOutputLocation == 'bodyEnd') %}

{# =============================================================================== #}

<!doctype html>
<html prefix="og: https://ogp.me/ns#" class="no-js antialiased font-sans text-body selection:bg-accent selection:text-dark" lang="en">
<head>
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<script>document.documentElement.className = document.documentElement.className.replace(/\bno-js\b/,'js');</script>
	<meta charset="utf-8">
	<title>{{ title is defined ? title ~ ' | ' ~ siteName : siteName }}</title>

	{# ==================================
	FONTS.
	===================================== #}

	<style>
		@font-face {
			font-display: swap;
			font-family: 'Bricolage Grotesque';
			font-style: normal;
			font-weight: 400;
			src: url('/assets/fonts/bricolage-grotesque-v2-latin-regular.woff2') format('woff2');
		}
		@font-face {
			font-display: swap;
			font-family: 'Poppins';
			font-style: normal;
			font-weight: 400;
			src: url('/assets/fonts/poppins-v21-latin-regular.woff2') format('woff2');
		}
		@font-face {
			font-display: swap;
			font-family: 'Poppins';
			font-style: italic;
			font-weight: 400;
			src: url('/assets/fonts/poppins-v21-latin-italic.woff2') format('woff2');
		}
		@font-face {
			font-display: swap;
			font-family: 'Poppins';
			font-style: normal;
			font-weight: 500;
			src: url('/assets/fonts/poppins-v21-latin-500.woff2') format('woff2');
		}
		[x-cloak]{ display:none!important; }
	</style>

	<meta name="description" content="{{ metaDesc is defined ? metaDesc|replace({'</li>': '. ','</ul>': ' ','</p>': ' ', '</h2>': ' ', '</h3>': ' '})|striptags : null }}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="format-detection" content="telephone=no">
	{% if noIndex is defined and noIndex == 1 or craft.app.config.env != 'live' %}<meta name="robots" content="noindex, nofollow">{% endif %}

	{#
		Because we insist on using a Structure section to store home pages instead of a Single,
		we should ensure that /home is canonicalised. Can't redirect or else live preview won't work.
		There's also a redirect in index.twig for cases where we're not in preview mode or viewing a
		home entry draft.
	 #}
	{% if craft.app.request.segment(1) == 'home' %}
		<link rel="canonical" href="{{ siteUrl }}">
	{% endif %}

	{# ======================================
	SOCIAL META. Use OG fallbacks to minimise complexity here.
	========================================= #}

	{% set ogTitle = ogTitle is defined and ogTitle ? ogTitle : title is defined and title ? title : siteName %}
	{% set ogDesc = ogDesc is defined and ogDesc ? ogDesc : metaDesc is defined and metaDesc ? metaDesc : null %}

	{% if ogImg is defined and ogImg %}
		{# Beware, this approach relies on your assets filesystem in Craft having a root-relative Base URL. If it doesn't for some reason, you'll need to change this next line to remove the siteUrl prefix.  #}
		{% set ogImgUrl = siteUrl|trim('/', 'right') ~ ogImg.url(craft.app.config.custom.globalTransforms.ogImg[0]) %}
		{% set ogWidth = ogImg.width() %}
		{% set ogHeight = ogImg.height() %}
	{% else %}
		{% set ogImgUrl = siteUrl ~ 'assets/img/logo-og.png' %}
		{% set ogWidth = 1200 %}
		{% set ogHeight = 1200 %}
	{% endif %}

	<meta name="twitter:card" content="{{ twitterCard ?? 'summary' }}">
	{% if  socialLinks.socialLinks|length %}
		{% if socialLinks.socialLinks|filter(row => row.service == 'x')|first %}
			<meta name="twitter:site" content="@{{ socialLinks.socialLinks|filter(row => row.service == 'x')|first.link|replace('https://x.com/','') }}">
		{% endif %}
		{% for socialLink in socialLinks.socialLinks %}
			<meta content="{{ socialLink.link }}" property="og:see_also">
		{% endfor %}
	{% endif %}
	{% if twitterCreator is defined and twitterCreator %}<meta name="twitter:creator" content="{{ twitterCreator }}">{% endif %}
	<meta property="og:title" content="{{ ogTitle }}">
	<meta property="og:type" content="{{ ogType ?? 'website' }}">
	<meta property="og:url" content="{{ craft.app.request.absoluteUrl }}">

	<meta property="og:image" content="{{ ogImgUrl }}">
	<meta property="og:image:height" content="{{ ogHeight }}">
	<meta property="og:image:width" content="{{ ogWidth }}">
	{% if ogDesc %}<meta property="og:description" content="{{ ogDesc|striptags }}">{% endif %}
	<meta property="og:site_name" content="{{ siteName }}">

	{% if socialLinks.fbAdmins|length %}
		{% for fbAdmin in socialLinks.fbAdmins %}
			<meta property="fb:admins" content="{{ fbAdmin.fbAccountNo }}">
		{% endfor %}
	{% endif %}

	{# Load our main CSS file to avoid FOUC in dev mode #}
	{% if craft.vite.devServerRunning() %}
		<link rel="stylesheet" href="{{ craft.vite.asset("src/css/main.css") }}">
	{% endif %}
	{# confusingly, this tag actually outputs both JS AND CSS assets when in production: #}
	{{ craft.vite.script('src/js/main.js', false) }}

	{# load any scripts directly held against the "Essential" category (not the stuff from the Scripts section, but the category itself) #}
	{% if essentialCat|length %}

		{# GTM consent preset ones... #}
		{% if essentialCat.gtmConsents|filter(row => row.value)|length %}
			<script>
				// Define dataLayer and the gtag function.
				window.dataLayer = window.dataLayer || [];
				function gtag(){dataLayer.push(arguments);}
				gtag('consent', 'default', {
					{%- for row in essentialCat.gtmConsents|filter(row => row.value) -%}
						'{{ row.key }}': '{{ row.value }}'{{ not loop.last ? ',' }}
					{%- endfor -%}
				});
			</script>
		{% endif %}

		{# and arbitrary ones... #}
		{% if essentialCat.script|length %}{{ essentialCat.script|raw }}{% endif %}
	{% endif %}

	{# load any essential scripts from the Scripts section set to appear in head #}
	{% if scriptsToLoadUpfrontAtHead|length %}
		{% for script in scriptsToLoadUpfrontAtHead %}
			{{ script.script|raw }}
		{% endfor %}
	{% endif %}

	{{ block('extraHeadData') ?? null }}

	{{ head() }}
</head>

<body class="m-0 {{ bodyClass ?? null }}">

	{# ==================================
	COOKIE CONSENT & SITE SCRIPTS.
	We need cookieConsent.twig to be at the top here
	so that Alpine initialises it before other
	components that might rely on it!
	===================================== #}

	{% set cookieCatsInUse = craft.entries.type('cookieTypes').relatedTo(craft.entries.section('scripts').ids()).all() %}

	{% if cookieCatsInUse|filter(cat => cat.id != essentialCat.id) %}
		{% include '_partials/cookieConsent.twig' %}
	{% endif %}

	{# ======================================================================= #}

	<div data-edit-this data-thing="{{ craft.app.urlManager.matchedElement.id ?? entry.id ?? null }}"></div>

	{{ beginBody() }}

	{# load any essential scripts from the Scripts section set to appear at body-start #}
	{% if scriptsToLoadUpfrontAtBodyStart|length %}
		{% for script in scriptsToLoadUpfrontAtBodyStart%}
			{{ script.script|raw }}
		{% endfor %}
	{% endif %}

	<div class="sr-only focus:not-sr-only" tabindex="0">
		<a href="#main" class="absolute z-50 left-0 top-0 m-0 bg-dark p-4 text-white">Skip to main content</a>
	</div>

	<div class="flex flex-col min-h-screen">

		{# =============================================================================== #}

		{% embed '_partials/container.twig' with {
			variants: 'squash',
			element:'header',
			sectionBG: 'silver',
			classes: ['relative', 'z-20']
		} %}
			{% block content %}
				<nav class="flex justify-between items-center">
					<a class="flex" href="/"><img alt="" style="height:50px" src="/assets/img/logo.svg"></a>

					<ul class="hidden md:flex space-x-8 ml-8">
						<li><a href="#" class="{{ _globals.get('css').navLink }}">Link</a></li>
						<li><a href="#" class="{{ _globals.get('css').navLink }}">Another</a></li>
					</ul>
				</nav>
			{% endblock %}
		{% endembed %}

		{# ==================================
		MOBILE NAV
		===================================== #}

		<nav class="md:hidden flex flex-col bg-brand">

			{% set naviconLineClasses = 'absolute block bg-accent transform' %}

			<button style="top:22px;height:60px;width:60px"
			        title="Menu"
			        class="mobile-nav-button flex items-center bg-white z-40 fixed right-0 mr-4 focus:outline-none js-toggle js-toggleScrollLock"
			        aria-controls="js-mobileNav"
			        data-active-target-id="js-mobileNav"
			        data-active-target="is-active"
			        data-active="is-active"
			        aria-expanded="false"
			>
				<span class="{{ naviconLineClasses }}"></span>
				<span class="{{ naviconLineClasses }}"></span>
				<span class="{{ naviconLineClasses }}"></span>
			</button>

			<div id="js-mobileNav" class="mobile-nav bg-gray-100 transition transform translate-x-full ease-out fixed z-30 inset-0 overflow-y-auto" aria-hidden="true">

				<div class="p-8">
					{% if socialLinks.socialLinks|length %}

						{% set socialLinksMap = {
							facebook: {
								label: 'Facebook',
								svg: '<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>'
							},
							linkedIn: {
								label: 'Linked In',
								svg: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>'
							},
							x: {
								label: 'X',
								svg: '<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>'
							},
							instagram: {
								label: 'Instagram',
								svg: '<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/></svg>'
							},
							pinterest: {
								label: 'Pinterest',
								svg: '<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/></svg>'
							},
							youtube: {
								label: 'YouTube',
								svg: '<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>'
							},
							vimeo: {
								label: 'Vimeo',
								svg: '<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M23.9765 6.4168c-.105 2.338-1.739 5.5429-4.894 9.6088-3.2679 4.247-6.0258 6.3699-8.2898 6.3699-1.409 0-2.578-1.294-3.553-3.881l-1.9179-7.1138c-.719-2.584-1.488-3.878-2.312-3.878-.179 0-.806.378-1.8809 1.132l-1.129-1.457a315.06 315.06 0 003.501-3.1279c1.579-1.368 2.765-2.085 3.5539-2.159 1.867-.18 3.016 1.1 3.447 3.838.465 2.953.789 4.789.971 5.5069.5389 2.45 1.1309 3.674 1.7759 3.674.502 0 1.256-.796 2.265-2.385 1.004-1.589 1.54-2.797 1.612-3.628.144-1.371-.395-2.061-1.614-2.061-.574 0-1.167.121-1.777.391 1.186-3.8679 3.434-5.7568 6.7619-5.6368 2.4729.06 3.6279 1.664 3.4929 4.7969z"/></svg>'
							}
						} %}
						<ul class="list-reset">
							{% for socialLink in socialLinks.socialLinks %}
								<li>
									<a class="flex gap-3 items-center" target="_blank" href="{{ socialLink.link }}">
										{% if socialLinksMap[socialLink.service] is defined %}
											<div class="size-4">{{ socialLinksMap[socialLink.service].svg|raw }}</div>
										{% endif %}
										{{ socialLink.labelOverride ?: socialLinksMap[socialLink.service].label }}
									</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</div>
			</div>
		</nav>

		{# =============================================================================== #}

		<main id="main">
			{{ block('content') }}
		</main>

		{# =============================================================================== #}

		{% embed '_partials/container.twig' with {
			element:'footer',
			sectionBG: 'silver',
			classes: ['mt-auto', 'relative'],
		} %}
			{% block content %}
				<p>&copy; {{ siteName }} {{ 'now'|date('Y') }}</p>
			{% endblock %}
		{% endembed %}

	</div>

	{# load any essential scripts from the Scripts section set to appear at body-end #}
	{% if scriptsToLoadUpfrontAtBodyEnd|length %}
		{% for script in scriptsToLoadUpfrontAtBodyEnd %}
			{{ script.script|raw }}
		{% endfor %}
	{% endif %}
	<div data-consented-scripts style="position:absolute;bottom:0;z-index:-1"></div>

	{{ endBody() }}

</body>
</html>
{% endminify %}