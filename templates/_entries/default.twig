{# ======================================
FINAL FALLBACK for generic pages like /terms /privacy etc,
but also provides base skeleton to inherit from for other entries
========================================= #}

{% extends '_layout.twig' %}

{# =============================================================================== #}

{% set title = entry.seo.titleTag ?? entry.title %}
{% set metaDesc = metaDesc ?? entry.seo.metaDesc ?? null %}
{% set noIndex = entry.seo.noIndex ?? null %}

{% set ogTitle = entry.seo.ogTitle ?? null %}
{% set ogDesc = entry.seo.ogDesc ?? null %}
{% set ogImg = ogImg is defined and ogImg|length ? ogImg : entry.seo.ogImage.exists() ? entry.seo.ogImage.one() : null %}
{% set ogType = entry.seo.ogType ?? null %}
{% set twitterCreator = entry.seo.twitterCreator ?? null %}
{% set twitterCard = entry.seo.twitterCard ?? null %}

{# =============================================================================== #}

{% block content %}
	<article>

		{# ==================================
        HEADER/HERO BANNER
        ===================================== #}

		{% block header %}
			{% include '_partials/header.twig' %}
		{% endblock %}

		{# ==================================
        BEFORE BB
        ===================================== #}

		{% block before %}{% endblock %}

		{# ==================================
        BODYBUILDER
        ===================================== #}

		{% include '_partials/bodyBuilder.twig' %}

		{# ==================================
        AFTER BB
        ===================================== #}

		{% block after %}{% endblock %}

	</article>
{% endblock %}