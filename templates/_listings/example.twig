{# ==================================
LISTING EXAMPLE
===================================== #}

{% extends '_listings/default.twig' %}

{# pageEntries should be set by handlers/elementsByCategory or handlers/elements #}
{% set pageEntries = pageEntries ?? null %}

{# ==================================
CATEGORY BUTTONS
===================================== #}

{#{% block cats %}#}
{#	{% embed '_partials/container.twig' %}#}
{#		{% block content %}#}
{#			{% include '_partials/categoryButtons.twig' with {catGroup: 'assetCats'} %}#}
{#		{% endblock %}#}
{#	{% endembed %}#}
{#{% endblock %}#}

{# ==================================
LISTING CONTENT
===================================== #}

{% block listingContent %}

	{# tweak the unit size based on how many items we're showing. Probably migrate these to use col-spans + CSS grid instead of widths + flexbox. #}
	{% switch pageEntries|length %}
		{% case '1' %}
			{% set itemSize = '' %}
		{% case '2' %}
			{% set itemSize = '' %}
		{% case '4' or '8' %}
			{% set itemSize = '' %}
		{% case '5' %}
			{% set itemSize = '' %}
		{% default %}
			{% set itemSize = '' %}
	{% endswitch %}

	{% if not craft.app.request.isAjax %}
		{% embed '_partials/container.twig' %}
			{% block content %}
				{% if not pageEntries %}
					<p>There are no items to display.</p>
				{% else %}
					<p>Show `pageEntries` here.</p>
					<p>(flexGrid.twig is now deprecated, as doing it manually with CSS grid instead of flexbox is no longer complex enough
					to require a dedicated partial (mainly because gap works 3-dimensionally without the need for all those negative margin
					hacks, and you can use col-spans for sizing the items instead of widths)).</p>

				{% endif %}
			{% endblock %}
		{% endembed %}
	{% else %}
		{# for ajax requests, we don't want a full grid with ul wrapper, we just want the individual list items to inject... #}
		{% for item in pageEntries %}
			<li class="{{ itemSize }}">
				{% include '_partials/cardDefault.twig' %}
			</li>
		{% endfor %}
	{% endif %}

{% endblock %}