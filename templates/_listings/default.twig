{# ======================================
LISTING DEFAULT. Used by:

* entries from the listingsPages section at /{slug} e.g. /blog, /case-studies
* /something-else/
* /something-else/category/{cat-slug}
* /another-thing

========================================= #}

{% set pageElement = category ?? entry %}

{% extends '_layout.twig' %}

{% set title = pageElement.seo.titleTag ?? pageElement.title %}
{% set metaDesc = pageElement.seo.metaDesc ?? null %}
{% set noIndex = pageElement.seo.noIndex ?? null %}

{% set ogTitle = pageElement.seo.ogTitle ?? null %}
{% set ogDesc = pageElement.seo.ogDesc ?? null %}
{% set ogImg = pageElement.seo.ogImage.exists() ? pageElement.seo.ogImage.one() %}
{% set ogType = pageElement.seo.ogType ?? null %}
{% set twitterCreator = pageElement.seo.twitterCreator ?? null %}
{% set twitterCard = pageElement.seo.twitterCard ?? null %}

{# SEO-friendly pagination links #}
{% block extraHeadData %}
	{% if withPagination is defined and withPagination and (pageInfo.prevUrl or pageInfo.nextUrl)%}
		{% if pageInfo.prevUrl %}<link rel="prev" href="{{ pageInfo.prevUrl }}">{% endif %}
		{% if pageInfo.nextUrl %}<link rel="next" href="{{ pageInfo.nextUrl }}">{% endif %}
	{% endif %}
{% endblock %}

{# ======================================================================= #}

{% block content %}

	{# ==================================
	INTRO or BANNER or CAROUSEL
	===================================== #}

	{% include '_partials/header.twig' %}

	{# ==================================
	CATS. Populated in child templates.
	===================================== #}

	{{ block('cats') ?? null }}

	{# ==================================
	LISTING. Populated in child templates.
	===================================== #}

	{{ block('listingContent') }}

	{# ==================================
	PAGINATION
	===================================== #}

	{% if withPagination is defined and withPagination and (pageInfo.prevUrl or pageInfo.nextUrl)%}

		{% set queryString = craft.app.request.getQueryStringWithoutPath() ? '?' ~ craft.app.request.getQueryStringWithoutPath() : '' %}

		{% embed '_partials/container.twig' with {sectionBG: 'silver', variants: 'squash'} %}
			{% block content %}
				{% set paginationCSS = {
					base: 'mt-0 px-8 !py-4 relative flex grow justify-center items-center border border-gray-300 bg-white font-bold text-body hover:bg-gray-50 focus:bg-gray-50',
				} %}

				{# ==================================
				Just two buttons @mobile...
				===================================== #}

				<div class="flex justify-between sm:hidden">
					{% if pageInfo.prevUrl %}
						{% include '_partials/button.twig' with { link: pageInfo.prevUrl ~ queryString, label:'Previous', variants: 'jumbo'} only %}
					{% endif %}
					{% if pageInfo.nextUrl %}
						{% include '_partials/button.twig' with { classes: 'mt-0', link: pageInfo.nextUrl ~ queryString, label:'Next', variants: 'jumbo'} only %}
					{% endif %}
				</div>

				{# ==================================
				DESKTOP
				===================================== #}

				<div class="hidden sm:block">
					<nav class="relative flex {{ pageInfo.totalPages <= 5 ? 'max-w-[50%]' }} rounded-md shadow-sm -space-x-px" aria-label="Pagination">

						{# ==================================
						PREV PAGE BUTTON
						===================================== #}

						{% if pageInfo.prevUrl %}
							<a href="{{ pageInfo.prevUrl ~ queryString }}" class="rounded-l-md {{ paginationCSS.base }}">
								<span class="sr-only">Previous</span>
								<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
								</svg>
							</a>
						{% endif %}

						{# ==================================
						PREV PAGES LINKS
						===================================== #}

						{% for page, url in pageInfo.getPrevUrls(5) %}
							<a href="{{ url ~ queryString }}" class="{{ paginationCSS.base }}">{{ page }}</a>
						{% endfor %}

						{# ==================================
						CURRENT FAUX-LINK
						===================================== #}

						<span class="{{ paginationCSS.base }} !bg-gray-200 hover:bg-gray-200">{{ pageInfo.currentPage }}</span>

						{# ==================================
						NEXT PAGES LINKS
						===================================== #}

						{% for page, url in pageInfo.getNextUrls(5) %}
							<a href="{{ url ~ queryString }}" class="{{ paginationCSS.base }}">{{ page }}</a>
						{% endfor %}

						{# ==================================
						NEXT PAGE BUTTON
						===================================== #}

						{% if pageInfo.nextUrl %}
							<a href="{{ pageInfo.nextUrl ~ queryString }}" class="rounded-r-md {{ paginationCSS.base }}">
								<span class="sr-only">Next</span>
								<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
								</svg>
							</a>
						{% endif %}
					</nav>
				</div>
			{% endblock %}
		{% endembed %}
	{% endif %}

{% endblock %}