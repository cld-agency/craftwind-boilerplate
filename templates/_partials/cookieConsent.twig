<div x-data="consent" @keydown.escape.prevent.stop="openModal = false">

	{# ==================================
	COOKIE MODAL & TRIGGER
	===================================== #}

	<button type="button"
		x-cloak
		x-show="getCookie('cookiesAccepted') || showModalTrigger"
		@click="openModal = !openModal;"
		:aria-expanded="openModal"
		aria-controls="cookie-modal"
		class="fixed bottom-0 z-40 left-0 bg-gray-300 text-xs px-2 py-1 hover:text-white hover:bg-dark transition duration-200 rounded-tr shadow-xl uppercase border-l-4 border-brand"
	>
		Cookies
	</button>

	<div id="cookie-modal" x-cloak x-show="openModal" x-trap.inert.noscroll="openModal" :aria-hidden="!openModal" class="fixed inset-0 z-50 flex justify-center items-center min-h-full p-8">
		<div class="fixed inset-0 bg-dark bg-opacity-90 transition-opacity"></div>

		<form class="mt-0 fixed flex flex-col bg-white rounded-lg overflow-hidden shadow-xl transition-all md:max-w-4xl max-w-[90vw] max-h-[72vh]">
			<h2 class="text-center px-8 py-4 md:py-8 md:px-12 bg-gray-100 fl:text-2xl">Allow the use of cookies in this browser?</h2>
			<div class="overflow-auto px-8 py-6 md:px-12">
				<p>This website uses cookies to ensure you get the best experience on our website. <a class="default-link" href="/cookies">Learn more about our cookies</a>.</p>

				{# ==================================
				LIGHTSWITCHES. Beware, these currently depend
				on some styles in project.css as not fully
				abstracted into Tailwind. The complexity of
				the selectors would make it a bit hairy in TW, but
				might be worth it one day for better cross-project
				portability...
				===================================== #}

				{% for cookieType in cookieCatsInUse %}
					<div class="flex mt-6">
						<div class="w-1/4 sm:w-1/6 mr-6 scale-75 md:scale-100">
							<label class="relative {{ cookieType.slug == 'essential' ? 'cursor-not-allowed' : 'cursor-pointer js-cookieLightswitch' }}" for="{{ cookieType.slug }}">
								<input {{ cookieType.slug == 'essential' ? 'checked disabled' }} type="checkbox" id="{{ cookieType.slug }}" name="cookieTypes[]" class="sr-only" value="1">
								<span aria-hidden="true" class="lightswitch-bg transition duration-200 rounded-full mx-auto h-9 w-20 flex items-center">
									<span class="lightswitch-indicator transition duration-200 bg-white block rounded-full h-8 w-8 ml-[2px]"></span>
									<span class="flex absolute w-20 justify-between" style="padding:0 11px 0 9px;font-size:0.5625rem;">
										<span class="transition duration-200 lightswitch-label">OFF</span>
										<span class="transition duration-200 lightswitch-label">ON</span>
									</span>
								</span>
								<span class="block mt-2 text-xs text-center font-display font-medium uppercase ">{{ cookieType.title }}</span>
							</label>
						</div>
						{% if cookieType.summaryPlainText|length %}
							<p class="mt-0 text-sm w-3/4 sm:w-5/6">{{ cookieType.summaryPlainText|nl2br }}</p>
						{% endif %}
					</div>
				{% endfor %}
			</div>

			{# ==================================
			SUBMIT BUTTONS
			===================================== #}

			<div class="flex justify-center border-t px-4 py-4 md:px-12 md:py-8 bg-gray-100">
				<div class="mr-4">
					{% include '_partials/button.twig' with {
						element:'button',
						label: 'Allow selected cookies',
						classes:'button-reset',
						attrs: {
							type:'button',
							'@click': "openModal = false; showModalTrigger = true; openBanner = false;  setChoices('')"
						},
						variants: ['secondary']
					} only %}
				</div>
				{% include '_partials/button.twig' with {
					element:'button',
					label: 'Accept all',
					classes: 'button-reset',
					attrs: {
						type:'button',
						'@click': "openModal = false; showModalTrigger = true; openBanner = false;  setChoices('all')"
					}
				} only %}
			</div>
		</form>
	</div>

	{# ==================================
	COOKIE BANNER
	===================================== #}

	<div x-show="openBanner" x-cloak :aria-hidden="!openBanner" class="max-w-screen-xl mx-auto mx-auto px-4 lg:px-8 fixed bottom-10 left-0 right-0 z-30">
		<div class="bg-gray-600 text-white shadow-xl p-4 sm:p-6 lg:p-8 rounded-lg">
			<div class="flex flex-col gap-8 justify-between">
				<div class="">
					<p class="fl:text-sm">This website uses cookies to ensure you get the best experience on our website. <a class="default-link" href="/cookies">Learn more about our cookies</a>.</p>
				</div>
				<div class="flex flex-wrap w-full gap-4">

					{% include '_partials/button.twig' with {
						label: 'Manage',
						variants: ['secondary','mini'],
						element: 'button',
						classes: 'button-reset mt-0 grow',
						attrs: {
							'type': 'button',
							'aria-controls': 'cookie-modal',
							':aria-expanded': 'openBanner',
							'@click': "openModal = true;"
						}
					} only %}

					{% include '_partials/button.twig' with {
						label: 'Reject',
						variants: ['secondary','mini'],
						element: 'button',
						classes:'button-reset mt-0 grow no-collapse',
						attrs: {
							'type': 'button',
							'@click': "openBanner = false; showModalTrigger = true; setChoices('none')"
						}
					} only %}

					{% include '_partials/button.twig' with {
						label: 'Accept',
						variants: ['mini'],
						element: 'button',
						classes:'button-reset mt-0 w-full no-collapse',
						attrs: {
							'type': 'button',
							'@click': "openBanner = false; showModalTrigger = true; setChoices('all')"
						}
					} only %}
				</div>
			</div>
		</div>
	</div>


	{# ==================================
	FUNCTIONALTIY COOKIES EXTRA PERMISSION MODAL.
	This appears when people who haven't consented
	to functionality cookies attempt to do something
	that requires that consent. E.g. for playing an
	embedded video, or filling in a form protected
	by reCAPTCHA, engaging with Live Chat, whatever.
	===================================== #}

	<div x-cloak x-show="openFunctionalityConsentModal" x-trap.inert.noscroll="openFunctionalityConsentModal" :aria-hidden="!openFunctionalityConsentModal" class="fixed inset-0 z-50 flex justify-center items-center min-h-full">
			<div class="fixed inset-0 bg-dark bg-opacity-90 transition-opacity"></div>
			<div class="mt-0 fixed flex flex-col bg-white overflow-hidden shadow-xl transition-all md:max-w-4xl max-w-[90vw] max-h-[72vh] p-8 default-links">
				<h2>We need your permission.</h2>

				{# you can override this message per instance. See e.g. lazyload-scripts.js #}
				<p x-text="functionalityModalMessage">To do that, please confirm that we may use functionality cookies.</p>

				<p>Find out more in our <a target="_blank" href="/cookies">Cookie Policy</a> and <a target="_blank" href="/privacy-policy">Privacy Policy</a>.</p>

				<div class="spacing flex gap-4">
					{% include '_partials/button.twig' with {
						element: 'button',
						variants: 'secondary',
						label: 'No thanks',
						attrs: {
							'type': 'button',
							'@click': "declineConsentableFunctionality()"
						}
					} only %}

					{% include '_partials/button.twig' with {
						element: 'button',
						label: 'OK, I accept',
						classes: 'mt-0',
						attrs: {
							'type': 'button',
							'@click': "openFunctionalityConsentModal = false; enableConsentableFunctionality(true)"
						}
					} only %}
				</div>
			</div>
		</div>

</div>