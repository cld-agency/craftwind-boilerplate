{# ==================================
BODY BUILDER BLOCK RENDERER. Add eager
loading here for stuff that's relatively
likely to be used, otherwise eager load
inside each block type. Beware that you
can't eager load image transforms when
using .eagerly(), so be sure to test well
and use e.g. `block.imgs.eagerly().withTransforms(...).all()`
on nested images.
===================================== #}

{% set blocks = blocks ?? entry.bodyBuilder.with([
	'widgetBlock:widget'
]).all() %}

{% if blocks|length %}
	{% for block in blocks %}

		{# set a slug for use as id attribute for in-page anchor linking #}
		{% set blockSlug = block.slug starts with '__temp' ? ('block-' ~ block.id) : block.slug %}

		{# Use Craft's auto-rendering to pluck a template out of _partials/entry/{entryTypeHandle}.twig #}
		{{ block.render({
			entry: block,
			pageEntry: entry
		}) }}
	{% endfor %}
{% endif %}