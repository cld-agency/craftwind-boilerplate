{# ==================================
BODY BUILDER
===================================== #}

{% set blocks = blocks ?? entry.bodyBuilder.with([
	'widgetBlock:widget'
]).all() %}

{% if blocks|length %}
	{% for block in blocks %}

		{# set a slug for use as id attribute for in-page anchor linking #}
		{% set blockSlug = block.slug starts with '__temp' ? ('block-' ~ block.id) : block.slug %}

		{# Use Craft's auto-rendering to pluck a template out of _partials/entry/{entryTypeHandle}.twig #}
		{{ block.render({ block: block, entry: entry }) }}
	{% endfor %}
{% endif %}