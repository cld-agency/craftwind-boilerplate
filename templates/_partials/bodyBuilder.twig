{# ==================================
BODY BUILDER
===================================== #}

{% set blocks = blocks ?? entry.bodyBuilder.with([
	'widgetBlock:widget'
]).all() %}

{% if blocks|length %}
	{% for block in blocks %}
		{% if block.type == 'widgetBlock' and block.widget|length %}
			{% set widgetEntry = block.widget[0] %}
			{% include [
				'_widgets/' ~ widgetEntry.slug|camel,
				'_widgets/' ~ widgetEntry.type.handle
			] ignore missing with {
				entry: widgetEntry,
				pageEntry: entry,
			} %}
		{% else %}
			{% include
				'_blocks/' ~ block.type
				ignore missing
			%}
		{% endif %}
	{% endfor %}
{% endif %}