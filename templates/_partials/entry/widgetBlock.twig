{# ==================================
WIDGET RENDERER
===================================== #}

{% set widgetEntry = entry.widget[0] ?? null %}

{# Overwrite the `entry` object with the widget entry, but also inject the widget block's section layout fields, as they should be changeable according to the context of their neighbouring blocks. #}

{% if widgetEntry %}
	{{ widgetEntry.render({
		entry: widgetEntry|merge({
			sectionBG: { value: entry.sectionBG.value }
		}),
		pageEntry: pageEntry
	}) }}
{% endif %}