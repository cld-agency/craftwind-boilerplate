{% if craft.app.request.param('types')|length %}
	{% set typeCats = craft.entries.section('cookieTypes').slug(craft.app.request.param('types')|split('|')).all() %}
	{% set typeCatIds = typeCats|column('id') %}
	{% set mode = craft.app.request.param('mode') %}
	{% if typeCats|length %}
		{% set scriptsQuery = craft.entries.section('scripts').cookieType(typeCatIds) %}
		{% if mode != 'ignoreFacades' %}
			{% do scriptsQuery.facades('none') %}
		{% endif %}
		{% set scripts = scriptsQuery.all() %}

		{% if scripts|length %}
			{# load the scripts held in the Scripts section under the chosen categories #}
			{% for script in scripts|filter(script => script.script|length) %}
				{{ script.script|raw }}
			{% endfor %}
		{% endif %}

		{# load any scripts directly held against the category (not the stuff from the Scripts section, but the category itself) #}
		{% for cat in typeCats %}
			{# GTM consent preset ones... #}
			{% set consentRows = cat.gtmConsents|filter(row => row.value) %}
			{% set consentJson = {} %}
			{% for row in consentRows %}
				{% set consentJson = consentJson|merge({ (row.key): row.value }) %}
			{% endfor %}
			{% if consentRows|length %}
				<script>
					(function() {
						var consent = {{ consentJson|json_encode|raw }};

						// Google Consent Mode — queue shim means this works even if gtag.js hasn't loaded yet
						window.dataLayer = window.dataLayer || [];
						function gtag() { dataLayer.push(arguments); }
						gtag('consent', 'update', consent);

						// Microsoft Ads (UET) — only ad_storage is read, so send just that
						// if (consent.ad_storage) {
						// 	window.uetq = window.uetq || [];
						// 	window.uetq.push('consent', 'update', { ad_storage: consent.ad_storage });
						// }

						// Microsoft Clarity — keys are case-sensitive (capital S) and only these two exist
						// var clarityConsent = {};
						// if (consent.ad_storage) { clarityConsent.ad_Storage = consent.ad_storage; }
						// if (consent.analytics_storage) { clarityConsent.analytics_Storage = consent.analytics_storage; }
						// if (Object.keys(clarityConsent).length) {
						// 	window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments); };
						// 	window.clarity('consentv2', clarityConsent);
						// }
					})();
				</script>
			{% endif %}

			{# and arbitrary ones... #}
			{% if cat.script|length %}{{ cat.script|raw }}{% endif %}
		{% endfor %}
	{% endif %}
{% else %}
	{% redirect 404 %}
{% endif %}