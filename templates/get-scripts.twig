{% if craft.app.request.param('types')|length %}
	{% set typeCats = craft.entries.section('cookieTypes').slug(craft.app.request.param('types')|split('|')).all() %}
	{% set typeCatIds = typeCats|column('id') %}
	{% set mode = craft.app.request.param('mode') %}
	{% if typeCats|length %}
		{% set scriptsQuery = craft.entries.section('scripts').cookieType(typeCatIds) %}
		{% if mode != 'ignoreFacades' %}
			{% do scriptsQuery.facades('none') %}
		{% endif %}
		{% set scripts = scriptsQuery.all() %}

		{% if scripts|length %}
			{# load the scripts held in the Scripts section under the chosen categories #}
			{% for script in scripts|filter(script => script.script|length) %}
				{{ script.script|raw }}
			{% endfor %}
		{% endif %}

		{# GTM consent presets, merged across all chosen categories into a single update (skipped on page load, where the layout's default already reflects these cookies) #}
		{% if mode != 'initialLoad' %}
			{% set consentJson = {} %}
			{% for cat in typeCats %}
				{% for row in cat.gtmConsents|filter(row => row.value) %}
					{% set consentJson = consentJson|merge({ (row.key): row.value }) %}
				{% endfor %}
			{% endfor %}
			{% if consentJson|length %}
				<script>
					window.sendConsent && window.sendConsent('update', {{ consentJson|json_encode|raw }});
				</script>
			{% endif %}
		{% endif %}

		{# load any scripts directly held against the category (not the stuff from the Scripts section, but the category itself) #}
		{% for cat in typeCats|filter(cat => cat.script|length) %}
			{{ cat.script|raw }}
		{% endfor %}
	{% endif %}
{% else %}
	{% redirect 404 %}
{% endif %}