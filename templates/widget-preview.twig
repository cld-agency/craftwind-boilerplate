{# ======================================
WIDGET PREVIEW PAGE
========================================= #}

{% extends '_layout.twig' %}

{# =============================================================================== #}

{% set title = 'Widget Preview' %}
{% set noIndex = true %}

{# =============================================================================== #}

{% block content %}

	{% set block = craft.entries.type('widgetBlock').relatedTo(entry).one() %}

	{% if block|length %}
		{% if craft.app.request.param('tryRealEntry') %}
			{% redirect block.owner.url() %}
		{% else %}
			{% embed '_partials/container.twig' %}
				{% block content %}
					<h1 style="text-align:center">Standalone widget preview</h1>
				{% endblock %}
			{% endembed %}

			{# Overwrite the `block` object with the widget entry, but also inject the widget block's section layout fields, as they should be changeable according to the context of their neighbouring blocks. #}
			{% set block = entry|merge({
				sectionBG: { value: block.sectionBG.value }
			}) %}

			{% include [
				'_blocks/' ~ entry.type.handle,
				'_widgets/' ~ entry.type.handle
			] ignore missing with {
				block: entry,
				blockSlug: entry.slug
			} %}

		{% endif %}
	{% else %}
		{% embed '_partials/container.twig' %}
			{% block content %}
				<h2 style="text-align:center">Standalone widget preview</h2>
				<p style="text-align:center">No entries are currently using this widget, so here is a standalone example preview:</p>
			{% endblock %}
		{% endembed %}

		{% include [
			'_blocks/' ~ entry.type.handle,
			'_widgets/' ~ entry.type.handle
		] ignore missing with {
			block: entry,
			blockSlug: entry.slug
		} %}
	{% endif %}

{% endblock %}