{
  "name": "cld-deerstalker",
  "version": "1.0.0",
  "scripts": {
    "all": "vite & npm-watch build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "watch": {
    "build": {
      "patterns": [
        "src/**/*"
      ],
      "ignore": "manifest.json",
      "extensions": "js,css,scss",
      "runOnChangeOnly": true,
      "inherit": true,
      "quiet": true,
      "silent": true
    }
  },
  "devDependencies": {
    "@lehoczky/postcss-fluid": "^1.0.3",
    "autoprefixer": "^10.4.19",
    "npm-watch": "^0.13.0",
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.13",
    "vite": "^6.0.1"
  },
  "dependencies": {
    "@alpinejs/focus": "^3.13.10",
    "alpinejs": "^3.9.6"
  }
}
