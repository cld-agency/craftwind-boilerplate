CRAFT_ENVIRONMENT=local
CRAFT_APP_ID=changeme
CRAFT_SECURITY_KEY=changeme

CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=localhost
CRAFT_DB_DATABASE=boilerplate
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=root
CRAFT_DB_TABLE_PREFIX=craft

SYSTEM_NAME="Craftwind Boilerplate"
SYSTEM_EMAIL=""

PRIMARY_SITE_URL=http://boilerplate.test

# To preview on a phone or tablet, set PRIMARY_SITE_URL=@web instead. Craft then
# builds URLs from the host each request arrived on, so your .test hostname and
# the sslip.io one below both yield working links, with no duplicate config.
# Local only — never @web on a public server, where Host headers aren't trustworthy.

# Browser-facing host for the Vite dev server. `npm run lan` rewrites this to
# <hostname>.<your-dashed-LAN-IP>.sslip.io, which every device on the Wi-Fi can
# resolve — see "Previewing on a phone or tablet" in the readme.
VITE_HOST=boilerplate.test

# Loopback, so Craft's "is the dev server up?" check skips a DNS round trip on
# every page load. ddev users want host.docker.internal here instead.
VITE_HOST_INTERNAL=127.0.0.1

VITE_PORT=4000
VITE_SSL_KEY=
VITE_SSL_CERT=

# Use Mailhog for local smtp. See config/app.php
SMTP_LOCAL_HOST=localhost
SMTP_LOCAL_PORT=1025
#SMTP_LOCAL_AUTHENTICATION=
#SMTP_LOCAL_USERNAME=
#SMTP_LOCAL_PASSWORD=
#SMTP_LOCAL_ENCRYPTION=
SMTP_LOCAL_TIMEOUT=10

# remote settings
# SMTP_USERNAME=aaa
# SMTP_PASSWORD=bbb
#
AVIF_SUPPORT=false